# ─── Cloudflare Workers AI ────────────────────────────────────────────────────
# Required. Get these from https://dash.cloudflare.com/
#   → Workers AI → API tokens / Account ID
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Optional — defaults are set in lib/cloudflare.ts if these are absent.
# CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# ─── assistant-ui cloud (optional) ────────────────────────────────────────────
# Enables persistent thread history. Sign up at https://cloud.assistant-ui.com/
# NEXT_PUBLIC_ASSISTANT_BASE_URL=
